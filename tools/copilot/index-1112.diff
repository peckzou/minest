+.tw-app {
+  --tw-ink: #1d2530;
+  --tw-paper: #f7f5f0;
+  --tw-line: #d9d5cc;
+  --tw-accent: #d94625;
+  box-sizing: border-box;
+}
+
+.tw-app * {
+  box-sizing: border-box;
+}
+
+.tw-app {
+  position: fixed;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  font: 15px/1.5 system-ui, -apple-system, 'PingFang SC', 'Noto Sans SC', sans-serif;
+  color: var(--tw-ink);
+  background: var(--tw-paper);
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+/* ---------------- \u9876\u680F ---------------- */
+
+.tw-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 10px 14px;
+  border-bottom: 1px solid var(--tw-line);
+  background: rgba(255, 255, 255, 0.72);
+  backdrop-filter: blur(10px);
+  flex: none;
+}
+
+.tw-top-left,
+.tw-top-right {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+}
+
+.tw-top-title {
+  font-size: 15px;
+  letter-spacing: 0.04em;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.tw-btn {
+  font: inherit;
+  font-size: 13px;
+  padding: 6px 11px;
+  border-radius: 999px;
+  border: 1px solid var(--tw-line);
+  background: #fff;
+  color: inherit;
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.tw-btn:hover {
+  border-color: var(--tw-accent);
+}
+
+.tw-btn[aria-pressed='true'] {
+  background: var(--tw-accent);
+  border-color: var(--tw-accent);
+  color: #fff;
+}
+
+.tw-select {
+  font: inherit;
+  font-size: 13px;
+  padding: 6px 8px;
+  border-radius: 10px;
+  border: 1px solid var(--tw-line);
+  background: #fff;
+  color: inherit;
+  max-width: 40vw;
+}
+
+/* ---------------- \u821E\u53F0 ---------------- */
+
+.tw-body {
+  position: relative;
+  flex: 1;
+  min-height: 0;
+}
+
+.tw-stage {
+  position: absolute;
+  inset: 0;
+  overflow: hidden;
+}
+
+.tw-readout {
+  position: absolute;
+  left: 50%;
+  bottom: 12px;
+  transform: translateX(-50%);
+  max-width: min(92vw, 900px);
+  padding: 7px 16px;
+  border-radius: 999px;
+  background: rgba(20, 24, 30, 0.62);
+  color: #f5f2ec;
+  font-size: 14px;
+  letter-spacing: 0.06em;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  pointer-events: none;
+}
+
+/* ---------------- \u8F93\u5165 ---------------- */
+
+.tw-composer {
+  flex: none;
+  display: flex;
+  align-items: flex-end;
+  gap: 10px;
+  padding: 10px 14px 12px;
+  border-top: 1px solid var(--tw-line);
+  background: #fff;
+}
+
+.tw-composer textarea {
+  flex: 1;
+  font: inherit;
+  font-size: 17px;
+  line-height: 1.45;
+  padding: 10px 12px;
+  border-radius: 12px;
+  border: 1px solid var(--tw-line);
+  background: #fdfcfa;
+  color: inherit;
+  resize: none;
+  min-height: 56px;
+}
+
+.tw-composer textarea:focus {
+  outline: 2px solid rgba(217, 70, 37, 0.35);
+  outline-offset: 1px;
+}
+
+.tw-submit {
+  flex: none;
+  width: 46px;
+  height: 46px;
+  border-radius: 12px;
+  border: 0;
+  background: var(--tw-accent);
+  color: #fff;
+  font-size: 18px;
+  cursor: pointer;
+}
+
+.tw-submit:disabled {
+  background: #cfcac0;
+  cursor: default;
+}
+
+.tw-composer p {
+  position: absolute;
+  right: 72px;
+  bottom: 4px;
+  margin: 0;
+  font-size: 11px;
+  color: #8a857c;
+}
+
+/* ---------------- \u753B\u5ECA ---------------- */
+
+.tw-gallery {
+  position: absolute;
+  inset: 0;
+  z-index: 20;
+  display: flex;
+  flex-direction: column;
+  background: rgba(247, 245, 240, 0.97);
+  backdrop-filter: blur(6px);
+}
+
+.tw-gallery-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 14px 16px;
+  border-bottom: 1px solid var(--tw-line);
+  flex: none;
+}
+
+.tw-gallery-head b {
+  display: block;
+  font-size: 17px;
+  letter-spacing: 0.06em;
+}
+
+.tw-gallery-head span {
+  font-size: 12px;
+  color: #8a857c;
+}
+
+.tw-gallery-filters {
+  display: flex;
+  gap: 6px;
+}
+
+.tw-gallery-filters button {
+  font: inherit;
+  font-size: 13px;
+  padding: 5px 12px;
+  border-radius: 999px;
+  border: 1px solid var(--tw-line);
+  background: #fff;
+  cursor: pointer;
+}
+
+.tw-gallery-filters button.is-on {
+  background: var(--tw-ink);
+  border-color: var(--tw-ink);
+  color: #fff;
+}
+
+.tw-gallery-close {
+  font-size: 18px !important;
+  line-height: 1;
+  padding: 4px 11px !important;
+}
+
+.tw-gallery-body {
+  flex: 1;
+  overflow-y: auto;
+  padding: 12px 16px 40px;
+  -webkit-overflow-scrolling: touch;
+}
+
+.tw-gallery-body h3 {
+  margin: 18px 0 8px;
+  font-size: 12px;
+  letter-spacing: 0.16em;
+  color: #8a857c;
+  font-weight: 600;
+}
+
+.tw-gallery-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
+  gap: 12px;
+}
+
+.tw-gallery-empty {
+  color: #8a857c;
+  font-size: 14px;
+}
+
+.tw-card {
+  border: 1px solid var(--tw-line);
+  border-radius: 14px;
+  overflow: hidden;
+  background: #fff;
+  display: flex;
+  flex-direction: column;
+}
+
+.tw-card.is-active {
+  border-color: var(--tw-accent);
+  box-shadow: 0 0 0 2px rgba(217, 70, 37, 0.18);
+}
+
+.tw-card-preview {
+  position: relative;
+  aspect-ratio: 16 / 10;
+  background: #eee;
+}
+
+.tw-card-preview canvas {
+  width: 100%;
+  height: 100%;
+  display: block;
+}
+
+.tw-card-star {
+  position: absolute;
+  top: 6px;
+  right: 6px;
+  width: 30px;
+  height: 30px;
+  border-radius: 50%;
+  border: 0;
+  background: rgba(255, 255, 255, 0.82);
+  color: #b08a3e;
+  font-size: 15px;
+  cursor: pointer;
+}
+
+.tw-card-body {
+  padding: 10px 12px 12px;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  flex: 1;
+}
+
+.tw-card-body b {
+  font-size: 14px;
+}
+
+.tw-card-body p {
+  margin: 0;
+  font-size: 12px;
+  line-height: 1.45;
+  color: #6f6a62;
+  flex: 1;
+}
+
+.tw-card-go {
+  font: inherit;
+  font-size: 13px;
+  padding: 7px 12px;
+  border-radius: 10px;
+  border: 1px solid var(--tw-line);
+  background: #fff;
+  cursor: pointer;
+}
+
+.tw-card.is-active .tw-card-go {
+  background: var(--tw-accent);
+  border-color: var(--tw-accent);
+  color: #fff;
+}
+
+@media (max-width: 520px) {
+  .tw-top {
+    flex-wrap: wrap;
+  }
+  .tw-select {
+    max-width: 30vw;
+  }
+  .tw-gallery-grid {
+    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
+  }
+}
