{
 "format": "minest.world/1",
 "id": "everyday-family",
 "version": 1,
 "versionString": "1.0.0",
 "family": "everyday",
 "name": "My Family History",
 "color": "#a0704f",
 "tagline": "The people, stories and places of my family.",
 "description": "Ancestors, family stories, old photos, traditions, hometowns and a family timeline.",
 "inspiration": "An everyday starter world for family history. Family members, children and family records are private by default: never shared or exported with your items unless you confirm. Add only what you are comfortable keeping.",
 "views": [
  "kanban",
  "contents",
  "portal"
 ],
 "recommendedViews": [
  "timeline",
  "gallery",
  "list"
 ],
 "depths": [
  "standard"
 ],
 "defaultDepth": "standard",
 "domains": [
  {
   "id": "ancestors",
   "title": "My Ancestors",
   "color": "#a0704f",
   "lists": [
    {
     "id": "my-family-members",
     "title": "My Family Members"
    },
    {
     "id": "my-family-branches",
     "title": "My Family Branches"
    }
   ]
  },
  {
   "id": "stories",
   "title": "My Family Stories",
   "color": "#d77a2f",
   "lists": [
    {
     "id": "my-family-memories",
     "title": "My Family Memories"
    },
    {
     "id": "my-oral-histories",
     "title": "My Oral Histories"
    }
   ]
  },
  {
   "id": "photos",
   "title": "My Family Photos",
   "color": "#5ab0c9",
   "lists": [
    {
     "id": "my-old-photos",
     "title": "My Old Photos"
    },
    {
     "id": "my-family-albums",
     "title": "My Family Albums"
    }
   ]
  },
  {
   "id": "traditions",
   "title": "My Traditions",
   "color": "#e8566c",
   "lists": [
    {
     "id": "my-celebrations",
     "title": "My Celebrations"
    },
    {
     "id": "my-family-customs",
     "title": "My Family Customs"
    }
   ]
  },
  {
   "id": "places",
   "title": "My Family Places",
   "color": "#43a047",
   "lists": [
    {
     "id": "my-hometowns",
     "title": "My Hometowns"
    },
    {
     "id": "my-important-places",
     "title": "My Important Places"
    }
   ]
  },
  {
   "id": "timeline",
   "title": "My Family Timeline",
   "color": "#7b5ce5",
   "lists": [
    {
     "id": "my-family-events",
     "title": "My Family Events"
    },
    {
     "id": "my-important-dates",
     "title": "My Important Dates"
    }
   ]
  }
 ],
 "starterPack": {
  "cover": {
   "art": "family"
  },
  "private": true,
  "fields": [
   {
    "id": "photo",
    "label": "Photo",
    "type": "image"
   },
   {
    "id": "born",
    "label": "Born",
    "type": "date",
    "hint": "A year is enough"
   },
   {
    "id": "relation",
    "label": "Relation to me",
    "type": "text"
   },
   {
    "id": "branch",
    "label": "Family branch",
    "type": "text"
   },
   {
    "id": "when",
    "label": "When",
    "type": "date",
    "timeline": true,
    "hint": "A year is enough"
   },
   {
    "id": "people",
    "label": "Who",
    "type": "ref",
    "refLists": [
     "ancestors/my-family-members"
    ],
    "newIn": "ancestors/my-family-members"
   },
   {
    "id": "place",
    "label": "Where",
    "type": "ref",
    "refLists": [
     "places/*"
    ],
    "newIn": "places/my-important-places"
   },
   {
    "id": "told",
    "label": "Told by",
    "type": "text"
   },
   {
    "id": "story",
    "label": "The story",
    "type": "text",
    "multiline": true
   }
  ],
  "listFields": {
   "ancestors/*": [
    "photo",
    "relation",
    "born",
    "branch",
    "story"
   ],
   "stories/*": [
    "when",
    "people",
    "place",
    "told",
    "story"
   ],
   "photos/*": [
    "photo",
    "when",
    "people",
    "place",
    "story"
   ],
   "traditions/*": [
    "photo",
    "when",
    "people",
    "story"
   ],
   "places/*": [
    "photo",
    "when",
    "story"
   ],
   "timeline/*": [
    "when",
    "people",
    "place",
    "story"
   ]
  },
  "quickAdd": {
   "label": "Add a Family Story",
   "mode": "form",
   "targets": [
    "stories/*"
   ],
   "titleLabel": "The story is about…"
  },
  "more": [
   {
    "label": "Add a Family Member",
    "targets": [
     "ancestors/*"
    ],
    "titleLabel": "Name"
   },
   {
    "label": "Add an Old Photo",
    "targets": [
     "photos/*"
    ],
    "titleLabel": "What is in it?"
   },
   {
    "label": "Add an Event",
    "targets": [
     "timeline/*"
    ],
    "titleLabel": "Event"
   }
  ],
  "gallery": {
   "label": "Family Album",
   "lists": [
    "photos/*",
    "ancestors/*",
    "traditions/*"
   ]
  },
  "discoveryTools": [],
  "explore": "timeline"
 }
}