{
 "format": "minest.world/1",
 "id": "everyday-places",
 "version": 1,
 "versionString": "1.0.0",
 "family": "everyday",
 "name": "My Places World",
 "color": "#2e8bc9",
 "tagline": "Where I’ve been and where I’ll go.",
 "description": "Cities, favourite spots, trips, dream destinations and routes — visited or someday.",
 "inspiration": "An everyday starter world for places. Locations are only what you type: Minest never reads your position, and nothing about where you are is shared. Trips with a date line up on your timeline.",
 "views": [
  "kanban",
  "contents",
  "portal"
 ],
 "recommendedViews": [
  "list",
  "timeline",
  "gallery"
 ],
 "depths": [
  "standard"
 ],
 "defaultDepth": "standard",
 "domains": [
  {
   "id": "cities",
   "title": "My Cities",
   "color": "#2e8bc9",
   "lists": [
    {
     "id": "my-visited-cities",
     "title": "My Visited Cities"
    },
    {
     "id": "my-favorite-cities",
     "title": "My Favorite Cities"
    }
   ]
  },
  {
   "id": "favorites",
   "title": "My Favorite Places",
   "color": "#e8566c",
   "lists": [
    {
     "id": "my-parks",
     "title": "My Parks"
    },
    {
     "id": "my-restaurants",
     "title": "My Restaurants"
    },
    {
     "id": "my-landmarks",
     "title": "My Landmarks"
    }
   ]
  },
  {
   "id": "trips",
   "title": "My Trips",
   "color": "#f08c3a",
   "lists": [
    {
     "id": "my-past-trips",
     "title": "My Past Trips"
    },
    {
     "id": "my-travel-memories",
     "title": "My Travel Memories"
    }
   ]
  },
  {
   "id": "dreams",
   "title": "My Dream Destinations",
   "color": "#9b5de5",
   "lists": [
    {
     "id": "my-want-to-visit",
     "title": "My Want to Visit"
    },
    {
     "id": "my-travel-wishlist",
     "title": "My Travel Wishlist"
    }
   ]
  },
  {
   "id": "routes",
   "title": "My Routes",
   "color": "#43a047",
   "lists": [
    {
     "id": "my-walking-routes",
     "title": "My Walking Routes"
    },
    {
     "id": "my-travel-routes",
     "title": "My Travel Routes"
    }
   ]
  }
 ],
 "starterPack": {
  "cover": {
   "art": "places"
  },
  "private": true,
  "fields": [
   {
    "id": "photo",
    "label": "Photo",
    "type": "image"
   },
   {
    "id": "location",
    "label": "Where",
    "type": "text",
    "hint": "City or area — only what you want to write"
   },
   {
    "id": "visited",
    "label": "Been there",
    "type": "boolean"
   },
   {
    "id": "when",
    "label": "When",
    "type": "date",
    "timeline": true,
    "hint": "A year is enough"
   },
   {
    "id": "rating",
    "label": "My rating",
    "type": "select",
    "options": [
     "★",
     "★★",
     "★★★",
     "★★★★",
     "★★★★★"
    ]
   },
   {
    "id": "link",
    "label": "Link",
    "type": "url"
   },
   {
    "id": "distance",
    "label": "Distance (km)",
    "type": "number"
   },
   {
    "id": "with",
    "label": "Who came",
    "type": "text"
   },
   {
    "id": "note",
    "label": "Notes",
    "type": "text",
    "multiline": true
   }
  ],
  "listFields": {
   "cities/*": [
    "photo",
    "location",
    "visited",
    "when",
    "rating",
    "note"
   ],
   "favorites/*": [
    "photo",
    "location",
    "visited",
    "rating",
    "link",
    "note"
   ],
   "trips/*": [
    "photo",
    "location",
    "when",
    "with",
    "note"
   ],
   "dreams/*": [
    "photo",
    "location",
    "link",
    "note"
   ],
   "routes/*": [
    "location",
    "distance",
    "when",
    "note"
   ]
  },
  "quickAdd": {
   "label": "Add a Place",
   "mode": "form",
   "targets": [
    "favorites/*",
    "cities/*",
    "dreams/*"
   ],
   "titleLabel": "Place"
  },
  "more": [
   {
    "label": "Add a Trip",
    "targets": [
     "trips/*"
    ],
    "titleLabel": "Trip"
   },
   {
    "label": "Add a Route",
    "targets": [
     "routes/*"
    ],
    "titleLabel": "Route"
   }
  ],
  "gallery": {
   "label": "My Places Gallery",
   "lists": [
    "*"
   ]
  },
  "discoveryTools": [
   "this-or-that",
   "desert-island"
  ],
  "explore": "timeline"
 }
}