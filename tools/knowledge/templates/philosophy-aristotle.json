 "name": "My Ordered World",
 "philosopher": "Aristotle",
 "color": "#b8862b",
 "tagline": "Everything in its place — and why it is there.",
 "description": "Sort my world by kinds of things, by what I know, do and make, and by how things change and why.",
 "inspiration": "Original: Aristotle used several different tools. The Categories lists ten ways of saying what something is (substance, quantity, quality, relation, place, time, position, state, action, affection). The Physics and Metaphysics give four causes — material, formal, efficient and final — to explain things and change. In the Metaphysics and Nicomachean Ethics, knowledge is theoretical (knowing), practical (acting well) or productive (making).\n\nMinest adaptation: this template keeps those ideas apart. Kinds of things shape My Natural World and My Things; knowing, doing and making shape My Knowledge, My Actions and My Creations; change and the four causes shape My Changes and My Explanations. The ten categories are kept as an advanced lens, not as folders.",
 "philosophy": {
  "primaryWorks": [
   "Categories",
   "Physics",
   "Metaphysics",
   "Nicomachean Ethics"
  ],
  "coreConcepts": [
   "classification of kinds",
   "substance and attributes",
   "the four causes",
   "change: potential and actual",
   "theoretical, practical and productive knowledge"
  ],
  "original": "Original: Aristotle used several different tools. The Categories lists ten ways of saying what something is (substance, quantity, quality, relation, place, time, position, state, action, affection). The Physics and Metaphysics give four causes — material, formal, efficient and final — to explain things and change. In the Metaphysics and Nicomachean Ethics, knowledge is theoretical (knowing), practical (acting well) or productive (making).",
  "adaptation": "Minest adaptation: this template keeps those ideas apart. Kinds of things shape My Natural World and My Things; knowing, doing and making shape My Knowledge, My Actions and My Creations; change and the four causes shape My Changes and My Explanations. The ten categories are kept as an advanced lens, not as folders."
 },
 "thinkingQuestions": [
  {
   "id": "q1",
   "text": "What kind of thing is this?"
  },
  {
   "id": "q2",
   "text": "What is it made of, what makes it what it is, what produced it, and what is it for?"
  },
  {
   "id": "q3",
   "text": "Is this about knowing, doing or making?"
  },
  {
   "id": "q4",
   "text": "How has it changed — and what could it become?"
  }
 ],
