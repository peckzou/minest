{
 "format": "minest.world/1",
 "id": "everyday-nature",
 "version": 1,
 "versionString": "1.0.0",
 "family": "everyday",
 "name": "My Nature World",
 "color": "#3f9e5a",
 "tagline": "What I notice in nature.",
 "description": "Birds, plants, places and weather — recorded like a field naturalist.",
 "inspiration": "An everyday starter world for nature observations: a photo, the date, where (only as much as you want to say) and the name of the species if you know it. Names you type are your own record; if AI identification is ever added, it will be marked as a suggestion, never a fact.",
 "views": [
  "kanban",
  "contents",
  "portal"
 ],
 "recommendedViews": [
  "gallery",
  "timeline",
  "list"
 ],
 "depths": [
  "standard"
 ],
 "defaultDepth": "standard",
 "domains": [
  {
   "id": "animals",
   "title": "My Animals",
   "color": "#c98a3a",
   "lists": [
    {
     "id": "my-birds",
     "title": "My Birds"
    },
    {
     "id": "my-mammals",
     "title": "My Mammals"
    },
    {
     "id": "my-fish",
     "title": "My Fish"
    },
    {
     "id": "my-insects",
     "title": "My Insects"
    }
   ]
  },
  {
   "id": "plants",
   "title": "My Plants",
   "color": "#43a047",
   "lists": [
    {
     "id": "my-flowers",
     "title": "My Flowers"
    },
    {
     "id": "my-trees",
     "title": "My Trees"
    },
    {
     "id": "my-garden-plants",
     "title": "My Garden Plants"
    }
   ]
  },
  {
   "id": "places",
   "title": "My Nature Places",
   "color": "#2e8b8b",
   "lists": [
    {
     "id": "my-parks",
     "title": "My Parks"
    },
    {
     "id": "my-trails",
     "title": "My Trails"
    },
    {
     "id": "my-favorite-natural-places",
     "title": "My Favorite Natural Places"
    }
   ]
  },
  {
   "id": "weather",
   "title": "My Weather",
   "color": "#5ab0c9",
   "lists": [
    {
     "id": "my-weather-observations",
     "title": "My Weather Observations"
    },
    {
     "id": "my-seasons",
     "title": "My Seasons"
    }
   ]
  },
  {
   "id": "walks",
   "title": "My Nature Walks",
   "color": "#8d6e63",
   "lists": [
    {
     "id": "my-outdoor-experiences",
     "title": "My Outdoor Experiences"
    },
    {
     "id": "my-discoveries",
     "title": "My Discoveries"
    }
   ]
  }
 ],
 "starterPack": {
  "cover": {
   "art": "nature"
  },
  "fields": [
   {
    "id": "photo",
    "label": "Photo",
    "type": "image"
   },
   {
    "id": "observed",
    "label": "Seen on",
    "type": "date",
    "timeline": true,
    "hint": "A year is enough"
   },
   {
    "id": "species",
    "label": "Species",
    "type": "text",
    "hint": "If you know it — your own note"
   },
   {
    "id": "where",
    "label": "Where",
    "type": "text",
    "hint": "Only what you want to write — never your exact position"
   },
   {
    "id": "count",
    "label": "How many",
    "type": "number"
   },
   {
    "id": "conditions",
    "label": "Weather",
    "type": "select",
    "options": [
     "Sunny",
     "Cloudy",
     "Rain",
     "Snow",
     "Windy",
     "Fog",
     "Storm"
    ]
   },
   {
    "id": "temp",
    "label": "Temperature",
    "type": "number"
   },
   {
    "id": "note",
    "label": "Notes",
    "type": "text",
    "multiline": true
   }
  ],
  "listFields": {
   "animals/*": [
    "photo",
    "observed",
    "species",
    "where",
    "count",
    "note"
   ],
   "plants/*": [
    "photo",
    "observed",
    "species",
    "where",
    "note"
   ],
   "places/*": [
    "photo",
    "where",
    "observed",
    "note"
   ],
   "weather/*": [
    "observed",
    "conditions",
    "temp",
    "note"
   ],
   "walks/*": [
    "photo",
    "observed",
    "where",
    "note"
   ]
  },
  "quickAdd": {
   "label": "Add an Observation",
   "mode": "form",
   "targets": [
    "animals/*",
    "plants/*",
    "walks/my-discoveries"
   ],
   "titleLabel": "What did you see?"
  },
  "more": [
   {
    "label": "Log the Weather",
    "targets": [
     "weather/*"
    ],
    "titleLabel": "Today’s weather"
   },
   {
    "label": "Add a Nature Place",
    "targets": [
     "places/*"
    ],
    "titleLabel": "Place"
   }
  ],
  "gallery": {
   "label": "Field Guide",
   "lists": [
    "animals/*",
    "plants/*",
    "walks/*"
   ]
  },
  "discoveryTools": [
   "this-or-that"
  ],
  "explore": "timeline"
 }
}