{
 "format": "minest.world/1",
 "id": "everyday-creative",
 "version": 1,
 "versionString": "1.0.0",
 "family": "everyday",
 "name": "My Creative World",
 "color": "#e0567c",
 "tagline": "My ideas, inspirations and creations.",
 "description": "Ideas, references, projects, creations and creative skills — from first spark to finished work.",
 "inspiration": "An everyday starter world for making things: capture ideas quickly, keep references, follow projects from idea to done, and link what inspired what.",
 "views": [
  "kanban",
  "contents",
  "portal"
 ],
 "recommendedViews": [
  "gallery",
  "kanban",
  "list"
 ],
 "depths": [
  "standard"
 ],
 "defaultDepth": "standard",
 "domains": [
  {
   "id": "ideas",
   "title": "My Ideas",
   "color": "#f2b134",
   "lists": [
    {
     "id": "my-new-ideas",
     "title": "My New Ideas"
    },
    {
     "id": "my-ideas-to-explore",
     "title": "My Ideas to Explore"
    }
   ]
  },
  {
   "id": "inspirations",
   "title": "My Inspirations",
   "color": "#e0567c",
   "lists": [
    {
     "id": "my-images",
     "title": "My Images"
    },
    {
     "id": "my-references",
     "title": "My References"
    },
    {
     "id": "my-favorite-designs",
     "title": "My Favorite Designs"
    }
   ]
  },
  {
   "id": "projects",
   "title": "My Projects",
   "color": "#7b5ce5",
   "lists": [
    {
     "id": "my-current-projects",
     "title": "My Current Projects"
    },
    {
     "id": "my-future-projects",
     "title": "My Future Projects"
    }
   ]
  },
  {
   "id": "creations",
   "title": "My Creations",
   "color": "#00a6a6",
   "lists": [
    {
     "id": "my-artworks",
     "title": "My Artworks"
    },
    {
     "id": "my-designs",
     "title": "My Designs"
    },
    {
     "id": "my-writing",
     "title": "My Writing"
    }
   ]
  },
  {
   "id": "skills",
   "title": "My Creative Skills",
   "color": "#1e88e5",
   "lists": [
    {
     "id": "my-drawing",
     "title": "My Drawing"
    },
    {
     "id": "my-design-skills",
     "title": "My Design Skills"
    },
    {
     "id": "my-writing-skills",
     "title": "My Writing Skills"
    }
   ]
  }
 ],
 "starterPack": {
  "cover": {
   "art": "creative"
  },
  "fields": [
   {
    "id": "image",
    "label": "Image",
    "type": "image"
   },
   {
    "id": "idea",
    "label": "The idea",
    "type": "text",
    "multiline": true
   },
   {
    "id": "source",
    "label": "Source",
    "type": "url"
   },
   {
    "id": "stage",
    "label": "Stage",
    "type": "select",
    "options": [
     "Spark",
     "Sketching",
     "Making",
     "Done"
    ]
   },
   {
    "id": "tags",
    "label": "Tags",
    "type": "multiselect",
    "options": [
     "Drawing",
     "Design",
     "Writing",
     "Photo",
     "Music",
     "Craft",
     "Digital"
    ]
   },
   {
    "id": "related",
    "label": "Inspired by",
    "type": "ref",
    "refLists": [
     "inspirations/*",
     "ideas/*"
    ]
   },
   {
    "id": "made",
    "label": "Finished",
    "type": "date",
    "timeline": true
   },
   {
    "id": "status",
    "label": "Level",
    "type": "select",
    "options": [
     "Want to learn",
     "Learning",
     "Can do"
    ]
   }
  ],
  "listFields": {
   "ideas/*": [
    "image",
    "idea",
    "tags",
    "related"
   ],
   "inspirations/*": [
    "image",
    "source",
    "tags",
    "idea"
   ],
   "projects/*": [
    "image",
    "idea",
    "stage",
    "tags",
    "related"
   ],
   "creations/*": [
    "image",
    "idea",
    "made",
    "tags",
    "related"
   ],
   "skills/*": [
    "status",
    "idea",
    "source"
   ]
  },
  "quickAdd": {
   "label": "Capture an Idea",
   "mode": "form",
   "targets": [
    "ideas/*"
   ],
   "titleLabel": "Idea"
  },
  "more": [
   {
    "label": "Save an Inspiration",
    "targets": [
     "inspirations/*"
    ],
    "titleLabel": "What is it?"
   },
   {
    "label": "Start a Project",
    "targets": [
     "projects/*"
    ],
    "titleLabel": "Project"
   },
   {
    "label": "Add a Creation",
    "targets": [
     "creations/*"
    ],
    "titleLabel": "Title"
   }
  ],
  "gallery": {
   "label": "Moodboard",
   "lists": [
    "inspirations/*",
    "creations/*",
    "ideas/*"
   ]
  },
  "discoveryTools": [
   "connect-my-world",
   "tier-list"
  ],
  "explore": "kanban"
 }
}