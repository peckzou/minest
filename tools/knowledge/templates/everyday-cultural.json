  },
  "fields": [
   {
    "id": "cover",
    "label": "Cover",
    "type": "image"
   },
   {
    "id": "creator",
    "label": "By",
    "type": "text",
    "hint": "Author, director, artist or studio"
   },
   {
    "id": "year",
    "label": "Year",
    "type": "number"
   },
   {
    "id": "rating",
    "label": "My rating",
    "type": "select",
    "options": [
     "★",
     "★★",
     "★★★",
     "★★★★",
     "★★★★★"
    ]
   },
   {
    "id": "status",
    "label": "Status",
    "type": "select",
    "options": [
     "Want to",
     "In progress",
     "Finished"
    ]
   },
   {
    "id": "genre",
    "label": "Kind",
    "type": "multiselect",
    "options": [
     "Adventure",
     "Comedy",
     "Drama",
     "Fantasy",
     "Mystery",
     "Science",
     "History",
     "Music",
     "Family"
    ]
   },
   {
    "id": "link",
    "label": "Link",
    "type": "url"
   },
   {
    "id": "note",
    "label": "My thoughts",
    "type": "text",
    "multiline": true
   }
  ],
  "listFields": {
   "books/*": [
    "cover",
    "creator",
    "year",
    "status",
    "rating",
    "genre",
    "note"
