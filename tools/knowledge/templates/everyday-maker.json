     "id": "my-hand-tools",
     "title": "My Hand Tools"
    },
    {
     "id": "my-power-tools",
     "title": "My Power Tools"
    },
    {
     "id": "my-digital-tools",
     "title": "My Digital Tools"
    }
   ]
  },
  {
   "id": "materials",
   "title": "My Materials",
   "color": "#8d6e63",
   "lists": [
    {
     "id": "my-supplies",
     "title": "My Supplies"
    },
    {
     "id": "my-components",
     "title": "My Components"
    }
   ]
  },
  {
   "id": "builds",
   "title": "My Builds",
   "color": "#d77a2f",
   "lists": [
    {
     "id": "my-current-builds",
     "title": "My Current Builds"
    },
    {
     "id": "my-finished-builds",
     "title": "My Finished Builds"
    }
   ]
  },
  {
   "id": "repairs",
   "title": "My Repairs",
   "color": "#e8566c",
   "lists": [
    {
     "id": "my-things-to-fix",
     "title": "My Things to Fix"
    },
    {
     "id": "my-repair-history",
     "title": "My Repair History"
    }
   ]
  },
  {
   "id": "experiments",
   "title": "My Experiments",
   "color": "#7b5ce5",
   "lists": [
    {
     "id": "my-tests",
     "title": "My Tests"
    },
    {
     "id": "my-results",
     "title": "My Results"
    }
   ]
  },
  {
   "id": "projects",
   "title": "My Projects",
   "color": "#1e88e5",
   "lists": [
    {
     "id": "my-plans",
     "title": "My Plans"
    },
    {
     "id": "my-project-notes",
     "title": "My Project Notes"
    }
   ]
  }
 ],
 "starterPack": {
  "cover": {
   "art": "maker"
  },
  "fields": [
   {
    "id": "photo",
    "label": "Photo",
    "type": "image"
   },
   {
    "id": "materials",
    "label": "Materials",
    "type": "text",
    "multiline": true,
    "hint": "One per line"
   },
   {
    "id": "tools",
    "label": "Tools",
    "type": "ref",
    "refLists": [
     "tools/*"
    ]
   },
   {
    "id": "steps",
    "label": "Steps",
    "type": "text",
    "multiline": true,
    "hint": "One step per line"
   },
   {
    "id": "stage",
    "label": "Status",
    "type": "select",
    "options": [
     "Planned",
     "In progress",
     "Done",
     "On hold"
    ]
   },
   {
    "id": "started",
    "label": "Started",
    "type": "date",
    "timeline": true
   },
   {
    "id": "cost",
    "label": "Cost",
    "type": "number"
   },
   {
    "id": "problem",
    "label": "What’s wrong",
    "type": "text",
    "multiline": true
   },
   {
    "id": "fixed",
    "label": "Fixed",
    "type": "boolean"
   },
   {
    "id": "result",
    "label": "What happened",
    "type": "text",
    "multiline": true
   },
   {
    "id": "qty",
    "label": "Quantity",
    "type": "text"
   },
   {
    "id": "brand",
    "label": "Make / model",
    "type": "text"
   },
   {
    "id": "link",
    "label": "Link",
    "type": "url"
   }
  ],
  "listFields": {
   "tools/*": [
    "photo",
    "brand",
    "link"
   ],
   "materials/*": [
    "qty",
    "link"
   ],
   "builds/*": [
    "photo",
    "stage",
    "materials",
    "tools",
    "steps",
    "started",
    "cost"
   ],
   "repairs/*": [
    "photo",
    "problem",
    "tools",
    "steps",
    "fixed",
    "started"
   ],
   "experiments/*": [
    "photo",
    "steps",
    "result",
    "started"
   ],
   "projects/*": [
    "stage",
    "materials",
    "steps",
    "link"
   ]
  },
  "quickAdd": {
   "label": "Start a Project",
   "mode": "form",
   "targets": [
    "builds/*",
    "projects/*"
   ],
   "titleLabel": "Project"
  },
  "more": [
   {
    "label": "Log a Repair",
    "targets": [
     "repairs/*"
    ],
    "titleLabel": "What needs fixing?"
   },
   {
    "label": "Add a Tool",
    "targets": [
     "tools/*"
    ],
    "titleLabel": "Tool"
   },
   {
    "label": "Note an Experiment",
    "targets": [
     "experiments/*"
    ],
    "titleLabel": "Experiment"
   }
  ],
  "gallery": {
   "label": "Build Photos",
   "lists": [
    "builds/*",
    "repairs/*",
    "experiments/*"
   ]
  },
  "discoveryTools": [],
  "explore": "kanban"
 }
}