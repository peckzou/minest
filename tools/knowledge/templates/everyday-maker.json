{
 "format": "minest.world/1",
 "id": "everyday-maker",
 "version": 1,
 "versionString": "1.0.0",
 "family": "everyday",
 "name": "My Maker World",
 "color": "#d77a2f",
 "tagline": "My tools, builds, fixes and experiments.",
 "description": "Tools, materials, builds, repairs and experiments — with materials lists and step-by-step notes.",
 "inspiration": "An everyday starter world for making and fixing: projects with their materials, tools and steps; repairs with what went wrong and how it was fixed; experiments with what you tried and what happened.",
 "views": [
  "kanban",
  "contents",
  "portal"
 ],
 "recommendedViews": [
  "kanban",
  "list",
  "gallery"
 ],
 "depths": [
  "standard"
 ],
 "defaultDepth": "standard",
 "domains": [
  {
   "id": "tools",
   "title": "My Tools",
   "color": "#5c6b7a",
   "lists": [
