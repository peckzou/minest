 "name": "My Connected World",
 "philosopher": "Baruch Spinoza",
 "color": "#2f9e8f",
 "tagline": "Everything in my world is connected.",
 "description": "See how the things in my life connect — causes, feelings, people and ideas.",
 "inspiration": "Original: In the Ethics, Spinoza describes one infinite Nature (“God or Nature”) of which everything is a part. Mind and body are the same thing understood in two ways (thought and extension). Our affects — joy, sadness and desire — follow from causes, and we become freer as we understand those causes through adequate ideas.\n\nMinest adaptation: Spinoza never wrote a catalogue of life areas. This template borrows his picture of one connected nature — causes, feelings and understanding — to organise a personal world. Choosing it does not mean you hold his views.",
 "philosophy": {
  "primaryWorks": [
   "Ethics (1677)"
  ],
  "coreConcepts": [
   "God or Nature (one substance)",
   "attributes: thought and extension",
   "modes",
   "causality",
   "affects (joy, sadness, desire)",
   "freedom through understanding"
  ],
  "original": "Original: In the Ethics, Spinoza describes one infinite Nature (“God or Nature”) of which everything is a part. Mind and body are the same thing understood in two ways (thought and extension). Our affects — joy, sadness and desire — follow from causes, and we become freer as we understand those causes through adequate ideas.",
  "adaptation": "Minest adaptation: Spinoza never wrote a catalogue of life areas. This template borrows his picture of one connected nature — causes, feelings and understanding — to organise a personal world. Choosing it does not mean you hold his views."
 },
 "thinkingQuestions": [
  {
   "id": "q1",
   "text": "What is this connected to?"
  },
  {
   "id": "q2",
   "text": "What caused this — and what does it lead to?"
  },
  {
   "id": "q3",
   "text": "Which feelings come from understanding, and which from not yet understanding?"
  },
  {
   "id": "q4",
   "text": "What would understanding this better change for me?"
  }
