 "starterPack": {
  "cover": {
   "art": "food"
  },
  "fields": [
   {
    "id": "photo",
    "label": "Photo",
    "type": "image"
   },
   {
    "id": "ingredients",
    "label": "Ingredients",
    "type": "text",
    "multiline": true,
    "hint": "One per line"
   },
   {
    "id": "steps",
    "label": "Steps",
    "type": "text",
    "multiline": true,
    "hint": "One step per line"
   },
   {
    "id": "time",
    "label": "Time (minutes)",
    "type": "number"
   },
   {
    "id": "servings",
    "label": "Servings",
    "type": "number"
   },
   {
    "id": "source",
    "label": "Source link",
    "type": "url"
   },
   {
    "id": "rating",
    "label": "My rating",
    "type": "select",
    "options": [
     "★",
     "★★",
     "★★★",
     "★★★★",
     "★★★★★"
    ]
   },
   {
    "id": "tags",
    "label": "Good for",
    "type": "multiselect",
    "options": [
     "Quick",
     "Healthy",
     "Comfort",
     "Party",
     "Kids",
     "Vegetarian"
    ]
   },
   {
    "id": "location",
    "label": "Where",
    "type": "text"
   },
   {
    "id": "url",
    "label": "Website",
    "type": "url"
   },
   {
    "id": "visited",
    "label": "Been there",
    "type": "boolean"
   },
   {
    "id": "quantity",
    "label": "Quantity",
    "type": "text"
   },
   {
    "id": "expires",
    "label": "Use by",
    "type": "date"
   },
   {
    "id": "status",
    "label": "Status",
    "type": "select",
    "options": [
     "Want to learn",
     "Learning",
     "Can do"
    ]
   },
   {
    "id": "when",
    "label": "When",
    "type": "date"
   },
   {
    "id": "note",
    "label": "Notes",
    "type": "text",
    "multiline": true
   }
  ],
  "listFields": {
   "recipes/*": [
    "photo",
    "ingredients",
    "steps",
    "time",
    "servings",
    "tags",
    "source",
    "rating"
   ],
   "favorites/*": [
    "photo",
    "rating",
    "note"
   ],
   "restaurants/*": [
    "photo",
    "location",
    "url",
    "visited",
    "rating",
    "note"
   ],
   "ingredients/my-pantry": [
    "quantity",
    "expires"
   ],
   "ingredients/my-fresh-ingredients": [
    "quantity",
    "expires"
   ],
   "ingredients/my-spices": [
    "quantity"
   ],
   "skills/my-techniques": [
    "status",
    "note"
   ],
   "skills/my-learning-recipes": [
    "photo",
    "ingredients",
    "steps",
    "status",
    "source"
   ],
   "memories/my-family-recipes": [
    "photo",
    "ingredients",
    "steps",
    "when",
    "note"
   ],
   "memories/my-special-meals": [
    "photo",
    "when",
    "location",
    "note"
   ]
  },
  "quickAdd": {
   "label": "Add a Recipe",
   "mode": "form",
   "targets": [
    "recipes/*",
    "skills/my-learning-recipes",
    "memories/my-family-recipes"
   ],
   "titleLabel": "Recipe name",
   "importText": true
  },
  "more": [
   {
    "label": "Add a Restaurant",
    "targets": [
     "restaurants/*"
    ],
    "titleLabel": "Restaurant"
   },
   {
    "label": "Add to My Pantry",
    "targets": [
     "ingredients/*"
    ],
    "titleLabel": "Ingredient"
   }
  ],
  "pickers": [
   {
    "label": "Pick my favorite foods",
    "catalog": "foods",
    "target": "favorites/my-favorite-dishes"
   }
  ],
  "gallery": {
   "label": "Food Gallery",
   "lists": [
    "recipes/*",
    "favorites/*",
    "memories/*",
    "skills/my-learning-recipes"
   ]
  },
  "discoveryTools": [
   "this-or-that",
   "desert-island"
  ],
  "explore": "portal"
 }
