{
 "format": "minest.world/1",
 "id": "everyday-memory",
 "version": 1,
 "versionString": "1.0.0",
 "family": "everyday",
 "name": "My Memory World",
 "color": "#c98a5a",
 "tagline": "The moments, people and places of my life.",
 "description": "Memories with dates, photos, the people in them and the places they happened — on a timeline.",
 "inspiration": "An everyday starter world for memories: each one can have a date (just a year is fine), photos, people and places, and they line up on your timeline. Memories and the people in them stay private.",
 "views": [
  "kanban",
  "contents",
  "timeline"
 ],
 "recommendedViews": [
  "timeline",
  "gallery",
  "list"
 ],
 "depths": [
  "standard"
 ],
 "defaultDepth": "standard",
 "domains": [
  {
   "id": "childhood",
   "title": "My Childhood",
   "color": "#f2a65a",
   "lists": [
    {
     "id": "my-early-memories",
     "title": "My Early Memories"
    },
    {
     "id": "my-childhood-places",
     "title": "My Childhood Places"
    },
    {
     "id": "my-childhood-friends",
     "title": "My Childhood Friends"
    }
   ]
  },
  {
   "id": "firsts",
   "title": "My First Times",
   "color": "#5ab0c9",
   "lists": [
    {
     "id": "my-first-experiences",
     "title": "My First Experiences"
    },
    {
     "id": "my-important-beginnings",
     "title": "My Important Beginnings"
    },
    {
     "id": "my-personal-milestones",
     "title": "My Personal Milestones"
    }
   ]
  },
  {
   "id": "days",
   "title": "My Important Days",
   "color": "#e8566c",
   "lists": [
    {
     "id": "my-celebrations",
     "title": "My Celebrations"
    },
    {
     "id": "my-turning-points",
     "title": "My Turning Points"
    },
    {
     "id": "my-special-moments",
     "title": "My Special Moments"
    }
   ]
  },
  {
   "id": "people",
   "title": "My People",
   "color": "#9b5de5",
   "lists": [
    {
     "id": "my-family-memories",
     "title": "My Family Memories"
    },
    {
     "id": "my-friends",
     "title": "My Friends"
    },
    {
     "id": "people-who-influenced-me",
     "title": "People Who Influenced Me"
    }
   ]
  },
  {
   "id": "places",
   "title": "My Places",
   "color": "#43a047",
   "lists": [
    {
     "id": "my-old-homes",
     "title": "My Old Homes"
    },
    {
     "id": "my-favorite-places",
     "title": "My Favorite Places"
    },
    {
     "id": "places-i-remember",
     "title": "Places I Remember"
    }
   ]
  },
  {
   "id": "stories",
   "title": "My Life Stories",
   "color": "#8d6e63",
   "lists": [
    {
     "id": "my-personal-stories",
     "title": "My Personal Stories"
    },
    {
     "id": "my-lessons",
     "title": "My Lessons"
    },
    {
     "id": "my-reflections",
     "title": "My Reflections"
    }
   ]
  }
 ],
 "starterPack": {
  "cover": {
   "art": "memory"
  },
  "private": true,
  "fields": [
   {
    "id": "photo",
    "label": "Photo",
    "type": "image"
   },
   {
    "id": "when",
    "label": "When",
    "type": "date",
    "yearOnly": true,
    "timeline": true,
    "hint": "A year is enough"
   },
   {
    "id": "people",
    "label": "Who was there",
    "type": "ref",
    "refLists": [
     "people/my-friends",
     "people/people-who-influenced-me",
     "childhood/my-childhood-friends"
    ],
    "newIn": "people/my-friends"
   },
   {
    "id": "places",
    "label": "Where",
    "type": "ref",
    "refLists": [
     "places/*",
     "childhood/my-childhood-places"
    ],
    "newIn": "places/places-i-remember"
   },
   {
    "id": "story",
    "label": "The story",
    "type": "text",
    "multiline": true
   },
   {
    "id": "relation",
    "label": "Who they are to me",
    "type": "text"
   },
   {
    "id": "location",
    "label": "Location",
    "type": "text",
    "hint": "Only what you want to write — never your exact position"
   },
   {
    "id": "years",
    "label": "When I was there",
    "type": "text"
   }
  ],
  "listFields": {
   "childhood/my-early-memories": [
    "photo",
    "when",
    "people",
    "places",
    "story"
   ],
   "firsts/*": [
    "photo",
    "when",
    "people",
    "places",
    "story"
   ],
   "days/*": [
    "photo",
    "when",
    "people",
    "places",
    "story"
   ],
   "people/my-family-memories": [
    "photo",
    "when",
    "people",
    "places",
    "story"
   ],
   "stories/*": [
    "when",
    "people",
    "places",
    "story"
   ],
   "people/my-friends": [
    "photo",
    "relation",
    "story"
   ],
   "people/people-who-influenced-me": [
    "photo",
    "relation",
    "story"
   ],
   "childhood/my-childhood-friends": [
    "photo",
    "relation",
    "story"
   ],
   "places/*": [
    "photo",
    "location",
    "years",
    "story"
   ],
   "childhood/my-childhood-places": [
    "photo",
    "location",
    "years",
    "story"
   ]
  },
  "quickAdd": {
   "label": "Add a Memory",
   "mode": "form",
   "targets": [
    "childhood/my-early-memories",
    "firsts/*",
    "days/*",
    "people/my-family-memories",
    "stories/*"
   ],
   "titleLabel": "What happened?"
  },
  "more": [
   {
    "label": "Add a Person",
    "targets": [
     "people/my-friends",
     "people/people-who-influenced-me",
     "childhood/my-childhood-friends"
    ],
    "titleLabel": "Name"
   },
   {
    "label": "Add a Place",
    "targets": [
     "places/*",
     "childhood/my-childhood-places"
    ],
    "titleLabel": "Place"
   }
  ],
  "gallery": {
   "label": "Memory Gallery",
   "lists": [
    "*"
   ]
  },
  "discoveryTools": [
   "this-or-that",
   "desert-island"
  ],
  "explore": "timeline"
 }
}