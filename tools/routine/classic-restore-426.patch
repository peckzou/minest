+import { Task, toIsoDate } from './routine';
+/** Calendar-day coordinates, independent of daylight-saving hours. Annual events keep their date identity. */
+export function eventTarget(task:Task,nowMs=Date.now()):Date|null{
+ const iso=toIsoDate(task.targetDate||task.date),m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
+ if(!m)return null;
+ const y=+m[1],month=+m[2]-1,day=+m[3],original=new Date(y,month,day);
+ if(original.getFullYear()!==y||original.getMonth()!==month||original.getDate()!==day)return null;
+ if(!task.isAnnual)return original;
+ const now=new Date(nowMs),today=new Date(now.getFullYear(),now.getMonth(),now.getDate());
+ const annual=(year:number)=>new Date(year,month,Math.min(day,new Date(year,month+1,0).getDate()));
+ let target=annual(now.getFullYear());if(target<today)target=annual(now.getFullYear()+1);return target;
+}
+export function eventDays(task:Task,nowMs=Date.now()):number{
+ const target=eventTarget(task,nowMs);if(!target)return 0;
+ const now=new Date(nowMs);return Math.round((Date.UTC(target.getFullYear(),target.getMonth(),target.getDate())-Date.UTC(now.getFullYear(),now.getMonth(),now.getDate()))/86400000);
+}
+export function eventDate(task:Task,nowMs=Date.now()):string{
+ const d=eventTarget(task,nowMs);return d?`${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`:'日期无效';
+}
