+import test from 'node:test';import assert from 'node:assert/strict';import {eventDays,eventDate,eventTarget} from '../src/model/eventDate';import {initialState,countdownDays} from '../src/model/routine';
+const task={...initialState('2026-11-09').tasks[0],targetDate:'2026-11-10'};
+test('event date labels use actual target date and signed past/today/future calendar days',()=>{assert.equal(eventDays(task,new Date(2026,10,9,23,59).getTime()),1);assert.equal(eventDays(task,new Date(2026,10,10,23).getTime()),0);assert.equal(eventDays(task,new Date(2026,10,11).getTime()),-1);assert.equal(eventDate(task,new Date(2026,10,9).getTime()),'2026.11.10');});
+test('calendar countdown is not an elapsed-hour calculation around daylight-saving changes',()=>{assert.equal(countdownDays({...task,targetDate:'2026-11-02'},new Date(2026,9,31,12).getTime()),2);assert.equal(countdownDays({...task,targetDate:'2027-03-15'},new Date(2027,2,13,12).getTime()),2);});
+test('annual targets advance to the next occurrence and leap-day anniversaries clamp to February',()=>{const t={...task,targetDate:'2024-02-29',isAnnual:true};assert.equal(eventDate(t,new Date(2026,1,27).getTime()),'2026.02.28');assert.equal(eventDate({...task,targetDate:'2026-12-25',isAnnual:true},new Date(2026,11,26).getTime()),'2027.12.25');});
+test('invalid dates do not silently roll over into another month',()=>{assert.equal(eventTarget({...task,targetDate:'2026-02-31'}),null);assert.equal(eventDate({...task,targetDate:'invalid'}),'日期无效');});
