+/** Silver water first, a delayed prismatic echo, then a long clean rest. Seconds, never frames. */
+export const SONIC_PERIOD=12.8;
+const smooth=(a:number,b:number,x:number)=>{const t=Math.max(0,Math.min(1,(x-a)/(b-a)));return t*t*(3-2*t);};
+export function sonicPattern(age:number){
+ const wave=smooth(0,.22,age)*(1-smooth(2.1,2.85,age));
+ const prism=smooth(3.05,3.55,age)*(1-smooth(4.05,5.35,age));
+ const phase=age<0||age>=5.35?'quiet':age<2.85?'water':age<3.05?'settle':'prism';
+ return {wave,prism,phase};
+}
