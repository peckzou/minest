--- /dev/null
+++ b/src/engine/FlowVisualTask.ts
@@ -0,0 +1,7 @@
+import type { Task } from "../model/routine";
+/** Partition the single Classic flow at the next activity. Data stays unchanged. */
+export function flowVisualTask(task: Task, tasks: Task[]): Task {
+  const end = tasks.reduce((end, next) => next.start > task.start
+    ? Math.min(end, next.start) : end, task.start + task.duration);
+  return end === task.start + task.duration ? task : { ...task, duration: end - task.start };
+}
