+import {scheduledAt,focusTotal} from "../model/schedule";
+import { Task, RoutineState, RoutineMode, getRun, elapsed, dayKey } from '../model/routine';
+import { eventTarget } from '../model/eventDate';
+import { BezierEngine } from './BezierEngine';
+const clamp=(x:number)=>Math.max(0,Math.min(1,x));
+/** Clock-derived remaining volume. Pausing freezes elapsed time; no animation-frame clock. */
+export function remainingLiquid(task:Task,state:RoutineState,date:string,now:number,mode:RoutineMode):number {
+ const run=getRun(state,task.id,date);
+ if(run.status==='completed'||run.status==='skipped')return 0;
+ if(run.status==='running'||run.status==='paused')return clamp(((run.targetSeconds??task.duration*60)-elapsed(run,now))/focusTotal(task,state,date));
+ if(mode==='modules')return 1;
+ if(mode==='countdown'||mode==='milestones'){
+  const end=eventTarget(task,now)?.getTime();if(end===undefined)return 1;
+  let start=task.liquidSince??new Date(`${task.date}T00:00:00`).getTime();
+  if(task.isAnnual){const target=new Date(end),y=target.getFullYear()-1,m=target.getMonth(),d=Math.min(target.getDate(),new Date(y,m+1,0).getDate());start=Math.max(start,new Date(y,m,d).getTime());}
+  if(!Number.isFinite(start)||end<=start)return now>=end?0:1;
+  return clamp((end-now)/(end-start));
+ }
+ const start=scheduledAt(task,date),end=scheduledAt(task,date,true);
+ return clamp((end-now)/Math.max(1,end-start));
+}
+/** Solve a horizontal liquid level by integrating the actual shared Bézier boundaries. */
