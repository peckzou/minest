+test('planned modules retain full liquid instead of using their synthetic timeline coordinates',()=>{let s=initialState('2026-11-09');assert.equal(remainingLiquid(s.tasks[0],s,'2026-11-09',new Date('2026-11-09T23:00:00').getTime(),'modules'),1);});
