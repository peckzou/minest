+test('time ranges, checklist lines, Chinese durations and AM/PM are parsed without leaving tokens in titles',()=>{let rows=parseTaskList('- [ ] 09:00–10:30 阅读\n10:30 工作 1小时30分钟\n2pm Walk 15 minutes',r);assert.deepEqual(rows.map(t=>t.title),['阅读','工作','Walk']);assert.deepEqual(rows.map(t=>t.duration),[90,90,15]);assert.equal(rows[2].start,840);});
