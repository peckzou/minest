diff --git a/src/components/BulkTaskEditor.tsx b/src/components/BulkTaskEditor.tsx
new file mode 100644
index 0000000..6e6568b
--- /dev/null
+++ b/src/components/BulkTaskEditor.tsx
@@ -0,0 +1,11 @@
+import {useMemo,useState,useEffect} from 'react';
+import {X,Upload} from 'lucide-react';
+import {Task,RoutineMeta,clock} from '../model/routine';
+import {parseTaskList} from '../model/bulkTasks';
+import {useDialog} from '../hooks/useDialog';
+export function BulkTaskEditor({routine,date,onAdd,onPreview,close}:{routine:RoutineMeta;date:string;onAdd:(tasks:Task[])=>void;onPreview:(tasks:Task[])=>void;close:()=>void}){
+ const [text,setText]=useState(''),[start,setStart]=useState('09:00'),[minutes,setMinutes]=useState(30),[fileError,setFileError]=useState('');const root=useDialog(close);
+ const result=useMemo(()=>{if(!text.trim())return {tasks:[] as Task[],error:''};try{return {tasks:parseTaskList(text,routine,{date,start:Number(start.slice(0,2))*60+Number(start.slice(3)),duration:minutes}),error:''};}catch(e){return {tasks:[] as Task[],error:(e as Error).message};}},[text,routine,date,start,minutes]);
+ useEffect(()=>onPreview(result.tasks),[result,onPreview]);
+ return <div className="studio-backdrop"><section className="modal bulk-editor" ref={root} role="dialog" aria-modal="true" aria-label="批量整理日程"><header><div><span className="eyebrow">LIST → ROUTINE</span><h2>批量整理日程</h2></div><button className="icon-button" aria-label="关闭批量整理" onClick={close}><X size={18}/></button></header><p>粘贴清单即可自动排好。可识别时间、时长、日期和常见图标，保存前会预览；这是本地解析，无需发送到第三方。</p><label>活动清单 / JSON<textarea aria-label="活动清单或 JSON" rows={6} value={text} placeholder={'09:00 阅读 30min 📖\n运动 45min\n工作 1h\n\n或粘贴 [{"title":"阅读","duration":30,"icon":"book"}]'} onChange={e=>{setText(e.target.value);setFileError('');}}/></label><div className="form-pair"><label>默认开始时间<input type="time" value={start} onChange={e=>setStart(e.target.value)}/></label><label>默认时长（分钟）<input type="number" min={5} max={240} value={minutes} onChange={e=>setMinutes(Number(e.target.value))}/></label></div><label className="bulk-file"><Upload size={15}/> 读取 JSON 文件<input type="file" aria-label="导入任务 JSON 文件" accept="application/json,.json" onChange={async e=>{const f=e.target.files?.[0];if(!f)return;try{if(f.size>5_000_000)throw new Error('文件超过 5 MB');setText(await f.text());setFileError('');}catch(err){setFileError((err as Error).message);}e.target.value='';}}/></label>{(result.error||fileError)&&<p role="alert">{result.error||fileError}</p>}<ol className="bulk-preview" aria-label="批量任务预览">{result.tasks.map(t=><li key={t.id}><strong>{t.title}</strong><span>{routine.mode==='timeline'?`${clock(t.start)} · ${t.duration} min`:routine.mode==='modules'?`${t.duration} min`:t.targetDate}</span></li>)}</ol><button className="primary-button" disabled={!result.tasks.length||!!result.error||!!fileError} onClick={()=>onAdd(result.tasks)}>添加 {result.tasks.length} 项活动</button><p className="studio-note">只在当前日程追加，已有任务不会被覆盖；添加后可以撤销。</p></section></div>;
+}
