{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "three": [
        "./node_modules/@types/three"
      ],
      "three/*": [
        "./node_modules/@types/three/*"
      ],
      "@v1/*": [
        "../typing-worlds-app/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
