# ─────────────────────────────────────────────
#  Minest — .gitignore
#  Covers: Web project + iOS/Xcode project
# ─────────────────────────────────────────────

# ──── macOS system files ─────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# ──── Web / temp dev files ───────────────────
.tmp_chrome/
focusboard-minest.zip
test_sim.png

# ──── iOS screenshots / test artifacts ───────
ios/*.png
ios/FocusIsland_*.png
ios/clean_sim.png

# ──── Xcode build outputs ────────────────────
# DerivedData (wherever it lives)
DerivedData/
build/
**/build/
ios/build/
ios/Minest/build_sim/
ios/FocusIsland/build/
**/DerivedData/

# Xcode temporary files
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.moved-aside
*.xcworkspace
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/

# Xcode user state (per-developer, not shared)
xcuserdata/
*.xcuserstate

# ──── Swift Package Manager ──────────────────
.build/
*.resolved
# Keep Package.swift and Package.resolved if used
# !Package.swift
# !Package.resolved

# ──── Fastlane / CI ──────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ──── Code signing (NEVER commit these) ──────
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest
ExportOptions.plist

# ──── IPA / Archives ─────────────────────────
*.ipa
*.dSYM.zip
*.dSYM/

# ──── Logs & caches ──────────────────────────
*.log
*.xcactivitylog
*.xcresult
ios/Logs/
build/Logs/

# ──── CocoaPods (if ever used) ───────────────
Pods/
*.xcworkspace
!*.xcodeproj/project.xcworkspace/

# ──── Node / Web tooling (if ever added) ─────
node_modules/
.env
.env.local
.env*.local
