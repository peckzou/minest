# Files the website never serves — kept in git, left out of every Vercel deployment
# so each deploy stays small (Vercel stores a full copy of the upload per deployment).

# iOS / watchOS app project and native build output
ios/

# badge and animation source projects (the built pages live in badge-*/ folders)
animation-sdk/
animation-sdk-*/
badge-system/
badge-source-*/

# local scripts and tests
*.py
*.sh
tools/*
# …except the two scripts Holo Lab loads at run time (holo-lab/index.html): the toolkit store (workbench) and wiki-map
!tools/toolkit
tools/toolkit/*
!tools/toolkit/store.js
!tools/toolkit/wiki-map.js
# …and the touch controls the built-in voxel islands load (cathedrals-island/, theme-park-island/)
!tools/islands
tools/islands/*
!tools/islands/island-touch.js
# …and the three World Search 2.0 loads unchanged (world-search-2/): 1.0's search bar, its host, and the list of philosophy models
!tools/toolkit/omni.js
!tools/toolkit/host.js
!tools/toolkit/phil-models.js
# …and the three dynamic-card scripts 动态卡片 2.0 loads as they are (cards-2/index.html)
!tools/cover-modes
tools/cover-modes/*
!tools/cover-modes/cover-modes.js
!tools/cover-modes/rolodex.js
!tools/cover-modes/glass-widgets.js
# (card-styles.js is also what the 卡片风格 2.0 page loads: card-styles-2/index.html)
!tools/cover-modes/card-styles.js
!tools/cover-modes/explode.js
# …and the eleven Dynamic presentations 动态呈现 2.0 loads as they are (dynamic-2/index.html)
!tools/knowledge-drive
tools/knowledge-drive/*
!tools/knowledge-drive/drive.css
!tools/knowledge-drive/sfx.js
!tools/knowledge-drive/drive.js
!tools/knowledge-drive/cars.js
!tools/knowledge-rail
tools/knowledge-rail/*
!tools/knowledge-rail/rail.css
!tools/knowledge-rail/phase3.css
!tools/knowledge-rail/rail-common.js
!tools/knowledge-rail/train.js
!tools/knowledge-rail/metro.js
!tools/knowledge-rail/tower.js
!tools/knowledge-rail/showcase-common.js
!tools/knowledge-rail/rack.js
!tools/knowledge-rail/library.js
!tools/knowledge-rail/museum.js
!tools/knowledge-rail/city.js
!tools/knowledge-rail/galaxy.js
!tools/knowledge-balloon
tools/knowledge-balloon/*
!tools/knowledge-balloon/balloon.css
!tools/knowledge-balloon/balloon.js

