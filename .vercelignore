# Files the website never serves — kept in git, left out of every Vercel deployment
# so each deploy stays small (Vercel stores a full copy of the upload per deployment).

# iOS / watchOS app project and native build output
ios/

# badge and animation source projects (the built pages live in badge-*/ folders)
animation-sdk/
animation-sdk-*/
badge-system/
badge-source-*/

# local scripts
*.py
*.sh

# old pages that no web address (vercel.json) or other page links to
awards.html
gestures.html
headsup.html
badge5.0.html
iPhone14.1.html
iPhone14.2.html
iPhone31.0.html
iPhone31.5.html
iphone12.8.html
iphone12.9.html

# old app versions: only the current iPhone and iPad builds are served
# (iphone.html / ipad.html are copies of them). On a new release, update the
# kept version below and its rewrites in vercel.json.
iPhone*.html
iphone[0-9]*.html
iPad*.html
# keep rules last: Vercel matches these patterns case-insensitively
!iPhone41.0.html
!iPad1.0.html
