 "notes": [
  { "title": "施陶巴赫瀑布", "text": "落差约 297 米，是瑞士最高的自由下落瀑布。水从悬谷尽头的峭壁上直落，在到达谷底之前几乎散成水雾，瀑布因此得名（Staub 意为“尘”）。1779 年歌德到访此地，写下《水上精灵之歌》。", "links": [ { "label": "Lauterbrunnen Tourismus", "url": "https://lauterbrunnen.swiss/de/sommer/sehen-und-erleben/ausfluege/ausflugsziele/staubbach-wasserfall/" }, { "label": "Wikipedia", "url": "https://en.wikipedia.org/wiki/Staubbach_Falls" } ] },
  { "title": "岩壁只画到 80 米", "text": "这块地 250 米见方，而瀑布落差 297 米，比地块还宽。岩壁在 80 米处被平切，像被地块边缘切开的建筑一样画成剖面；真实的落差是它的三倍多。岩壁的起伏、岩层颜色和水痕是照着照片画的示意，并非测量所得。引擎只画平地，谷底到崖脚的缓坡没有表现。", "links": [ { "label": "Wikimedia Commons 照片", "url": "https://commons.wikimedia.org/wiki/Category:Staubbachfall" } ] },
  { "title": "水量随季节变化", "text": "春季和初夏融雪时水势最盛；干燥的夏季水量明显减少。画面里春季的水带最宽、秋季较窄、冬季最细并偏冰色，宽窄的具体比例是示意。", "links": [ { "label": "Wikipedia", "url": "https://en.wikipedia.org/wiki/Staubbach_Falls" } ] },
  { "title": "哪些是测量的，哪些是示意", "text": "取自 OpenStreetMap：建筑轮廓、道路与步道、溪流、草甸和林地的范围、瀑布的位置。凭眼画的：全部建筑高度（11 栋都没有标注高度）、木屋的木色与屋顶、林地里每一棵树的位置和树种、冬季积雪、行人与车辆。通往瀑布背后的岩廊步道没有画出。", "links": [ { "label": "OpenStreetMap", "url": "https://www.openstreetmap.org/#map=17/46.58957/7.90663" } ] }
 ],
 "credits": [ { "label": "Lauterbrunnen Tourismus", "url": "https://lauterbrunnen.swiss/" } ]
